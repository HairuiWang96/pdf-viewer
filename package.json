{
  "name": "pdf-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "compare-pdfs": "node scripts/compare-pdfs.mjs"
  },
  "dependencies": {
    "@libpdf/core": "^0.4.2",
    "@progress/kendo-react-all": "^16.1.0",
    "@progress/kendo-svg-icons": "^5.4.0",
    "@progress/kendo-theme-default": "^14.5.0",
    "pdfjs-dist": "5.5.207",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "pdfjs-dist": "$pdfjs-dist"
  }
}
